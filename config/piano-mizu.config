# MizuSU root driver.
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_MANUAL_SU=y
# CONFIG_KPM is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set

# Required by the MizuSU Kconfig and syscall hook implementation.
CONFIG_KPROBES=y
CONFIG_EXT4_FS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# This is a production device build rather than a debug kernel. The stock
# config enables KASAN, UBSAN, debug info, LTO and CFI, which makes a complete
# Qualcomm kernel build exceed the reliable duration of a standard runner.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_KFENCE is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_LTO_CLANG_THIN is not set
CONFIG_LTO_NONE=y
# CONFIG_CFI_CLANG is not set

# Extra options for Droidspaces 7.1 and its optional Docker/KDE paths.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y

CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CFS_BANDWIDTH=y

CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_TMPFS_XATTR=y

# The seventeen tree already carries the modern NTSync driver. Keep it as a
# module because piano's stock vendor_dlkm module list includes ntsync.ko.
CONFIG_NTSYNC=m
