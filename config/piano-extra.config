# Extra options for Droidspaces 7.1 and its optional Docker/KDE paths.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y

CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CFS_BANDWIDTH=y

CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_TMPFS_XATTR=y

# The seventeen tree already carries the modern NTSync driver. Keep it as a
# module because piano's stock vendor_dlkm module list includes ntsync.ko.
CONFIG_NTSYNC=m
